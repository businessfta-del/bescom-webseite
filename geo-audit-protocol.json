{
  "$schema": "https://objektfunksysteme.de/geo-audit-protocol",
  "title": "GEO-Auditing-Protokoll – Zitationsfähigkeit in KI-Suchmaschinen",
  "site": "https://www.objektfunksysteme.de",
  "owner": "BESCom Elektronik GmbH",
  "version": "1.0",
  "erstellt": "2026-09-06",
  "zweck": "Monatliche Prüfung, ob objektfunksysteme.de als primäre Zitationsquelle in KI-Suchmaschinen (ChatGPT, Perplexity, Gemini, Copilot) für die zentralen B2B-Fragen erscheint.",
  "anleitung": {
    "haeufigkeit": "monatlich",
    "vorgehen": [
      "Jeden Prompt in ChatGPT, Perplexity, Gemini und Copilot eingeben.",
      "Prüfen, ob objektfunksysteme.de genannt/verlinkt (zitiert) wird.",
      "Ergebnis je KI unter 'ergebnisse' mit Datum eintragen (zitiert: true/false, position, notiz).",
      "Bei 'false': zugeordnete Ziel-URL auf Aktualität, Schema-Vollständigkeit und Antwort-Klarheit prüfen."
    ],
    "bewertung": {
      "zitiert": "URL wird als Quelle genannt/verlinkt",
      "erwaehnt": "Marke genannt, aber ohne Link",
      "nicht_sichtbar": "weder genannt noch verlinkt"
    }
  },
